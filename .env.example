# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT="gpt-4.1"
AZURE_OPENAI_EMBEDDING="text-embedding-3-large"

# Optional: GitHub token for integrations
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Vercel AI Gateway Configuration
# WARNING: VITE_-prefixed vars are embedded into the client bundle.
# This is acceptable for Tauri desktop apps (key stays local to user's machine)
# but MUST NOT be used in server-rendered web apps - use a server-only env var instead.
VITE_AI_GATEWAY_API_KEY=YOUR_AI_GATEWAY_KEY
VITE_AI_GATEWAY_MODEL="openai/gpt-4o"
VITE_AI_GATEWAY_EMBEDDING="openai/text-embedding-3-small"
VITE_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
