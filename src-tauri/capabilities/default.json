{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-greet",
    "allow-get-app-info",
    "allow-check-for-updates",
    "allow-download-update",
    "allow-update-install-support",
    "allow-update-staged",
    "process:default"
  ]
}
