{
  "name": "tauri-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:linux": "tauri build --config src-tauri/tauri.linux.conf.json",
    "tauri:build:macos": "tauri build --config src-tauri/tauri.macos.conf.json",
    "tauri:build:windows": "tauri build --config src-tauri/tauri.windows.conf.json",
    "test": "vitest",
    "lint": "oxlint .",
    "check": "pnpm run format:check && pnpm run lint:typed && pnpm run typecheck && pnpm run check:updater",
    "check:updater": "node scripts/check-updater-config.mjs",
    "lint:fix-unsafe": "oxlint --react-plugin --import-plugin --react-perf-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously .",
    "lint:typed": "oxlint --type-aware src",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "version:bump": "node scripts/update-version.cjs",
    "version:increment": "node scripts/version-manager.cjs increment",
    "version:build": "node scripts/version-manager.cjs increment --build",
    "version:patch": "node scripts/version-manager.cjs increment --patch",
    "version:info": "node scripts/version-manager.cjs current",
    "release:preflight": "node scripts/check-platform.cjs --verbose",
    "release:checksums": "node scripts/generate-checksums.cjs",
    "release:verify": "node scripts/verify-checksum.cjs",
    "release:macos:dmg-notarized": "bash scripts/platform/macos/build-dmg-notarized.sh",
    "release:windows:sign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/platform/windows/sign-installers.ps1",
    "typecheck": "tsc -b --pretty false",
    "release:windows:msstore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/platform/windows/build-msstore.ps1",
    "release:android:keystore": "bash scripts/platform/android/generate-release-keystore.sh",
    "release:android:keystore:encode": "bash scripts/platform/android/encode-keystore-for-github.sh",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.18",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "syncpack": "^15.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^24.18.0"
  },
  "packageManager": "pnpm@11.16.0"
}
