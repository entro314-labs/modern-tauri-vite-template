{
  "name": "tauri-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "lint": "oxlint src",
    "lint:typed": "oxlint --type-aware src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "check": "pnpm run format:check && pnpm run lint:typed",
    "knip": "knip",
    "version:bump": "node scripts/update-version.cjs",
    "release:preflight": "node scripts/check-platform.cjs --verbose",
    "release:checksums": "node scripts/generate-checksums.cjs",
    "release:verify": "node scripts/verify-checksum.cjs",
    "release:macos:dmg-notarized": "bash scripts/platform/macos/build-dmg-notarized.sh",
    "release:windows:sign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/platform/windows/sign-installers.ps1",
    "release:windows:msstore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/platform/windows/build-msstore.ps1",
    "release:android:keystore": "bash scripts/platform/android/generate-release-keystore.sh",
    "release:android:keystore:encode": "bash scripts/platform/android/encode-keystore-for-github.sh",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tanstack/react-router": "1.160.0",
    "@tauri-apps/api": "2.10.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/router-plugin": "1.160.0",
    "@tauri-apps/cli": "2.10.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.2.3",
    "jsdom": "28.1.0",
    "knip": "5.83.1",
    "lefthook": "2.1.1",
    "oxfmt": "0.32.0",
    "oxlint": "1.47.0",
    "oxlint-tsgolint": "0.12.2",
    "typescript": "5.9.3",
    "vite": "beta",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@10.29.3"
}
